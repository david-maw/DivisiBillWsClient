<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DivisiBillWsClient.AppShell"
    x:Name="shell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DivisiBillWsClient"
    Title="DivisiBillWsClient">

    <Shell.TitleView>
        <Grid>
            <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="Status"
            ContentTemplate="{DataTemplate local:CallStatusPage}"
            Route="CallStatusPage" />

        <ShellContent
            Title="Files"
            ContentTemplate="{DataTemplate local:Views.FileActivitiesPage}"
            Route="FileActivitiesPage" />

        <ShellContent
            Title="Items"
            ContentTemplate="{DataTemplate local:Views.StoredItemsPage}"
            Route="StoredItemsPage" />

        <ShellContent
            Title="Billing"
            ContentTemplate="{DataTemplate local:Views.BillingPage}"
            Route="BillingPage" />

        <ShellContent
            Title="Tables"
            ContentTemplate="{DataTemplate local:Views.TablePage}"
            Route="TablePage" />
    </TabBar>

</Shell>
