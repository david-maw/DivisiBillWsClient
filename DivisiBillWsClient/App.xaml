<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DivisiBillWsClient.Services"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DivisiBillWsClient.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:UtcToLocalDateTimeConverter x:Key="ToLocal" />
            <local:InvertBoolConverter x:Key="Not" />
            <toolkit:IsNullConverter x:Key="IsNull" />
            <toolkit:IsNotNullConverter x:Key="IsNotNull" />
            <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="IsNotNullOrWhiteSpace" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
