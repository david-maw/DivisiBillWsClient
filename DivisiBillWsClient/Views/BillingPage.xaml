<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DivisiBillWsClient.Views.BillingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DivisiBillWsClient.ViewModels"
    xmlns:models="clr-namespace:DivisiBillWsClient.Models"
    x:DataType="vm:BillingPageViewModel"
    BindingContext="{vm:BillingPageViewModel}"
    Title="Billing">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="10">

        <Label Text="Billing tests are only available on Android"
               HorizontalOptions="Center"
               FontSize="24"
               IsVisible="{OnPlatform Default=true, Android=false}"/>
        <!--  Pricing section  -->
        <VerticalStackLayout Grid.Row="0" Padding="10,10" Spacing="8" IsVisible="{OnPlatform Default=false, Android=true}">
            <Button
                Text="Load Prices"
                HorizontalOptions="Center"
                Command="{Binding LoadPricesCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                Margin="3" />
            <CollectionView ItemsSource="{Binding PriceItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PriceItem">
                        <Grid Padding="0,5" ColumnDefinitions="120,80" HorizontalOptions="Center">
                            <Label
                                Text="{Binding ProductName}"
                                FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                Text="{Binding Price}"
                                HorizontalTextAlignment="End" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Billing items Section -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{OnPlatform Default=false, Android=true}">
            <!--  Button to load subscriptions and licenses  -->
            <Button
            Text="Get Subscriptions &amp; Licenses"
            Command="{Binding LoadBillingItemsCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
            HorizontalOptions="Center"/>

            <!--  CollectionView to display billing items (subscriptions and licenses)  -->
            <CollectionView 
                ItemsSource="{Binding BillingItems}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedBillingItem}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BillingItem" xmlns:models="clr-namespace:DivisiBillWsClient.Models">
                        <Border
                        Padding="10"
                        Margin="0,5"
                        Stroke="#e0e0e0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="5">
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label
                                    Text="{Binding Purchase.ProductId}"
                                    FontAttributes="Bold"
                                    FontSize="14" />
                                    <Label
                                    Text="{Binding Purchase.Id}"
                                    FontAttributes="Bold"
                                    FontSize="14" />
                                    <Label
                                    Text="{Binding TypeDisplay}"
                                    FontAttributes="Bold"
                                    FontSize="14" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Purchase.ObfuscatedAccountId}" FontSize="12" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Purchase.TransactionDateUtc, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="12" />
                                    <Label Text="{Binding Purchase.State, StringFormat='State: {0}'}" FontSize="12" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label
                                    IsVisible="{Binding IsSubscription}"
                                    Text="{Binding Purchase.AutoRenewing, StringFormat='Auto-Renewing: {0}'}"
                                    FontSize="12" />
                                    <Label
                                    Text="Not Acknowledged"
                                    IsVisible="{Binding Purchase.IsAcknowledged, Converter={StaticResource Not}}"
                                    FontSize="12"
                                    TextColor="Red" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Verify Purchase Button and Result  -->
            <HorizontalStackLayout 
                IsVisible="{Binding SelectedBillingItem, Converter={StaticResource IsNotNull}}"
                Spacing="10" 
                Padding="0,10,0,0"
                HorizontalOptions="Center">
                <Button
                    Text="Verify Purchase"
                    Command="{Binding VerifyPurchaseCommand}"
                    Padding="20,10" />
                <Entry
                    Text="{Binding VerificationResult}"
                    IsReadOnly="True"
                    WidthRequest="120"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!--  Status message  -->
        <Label
            Grid.Row="3"
            Text="{Binding StatusMessage}"
            TextColor="{AppThemeBinding Default=LightGray, Light=DarkGrey}"
            HorizontalOptions="Center"
            FontSize="12"
            Margin="0,10,0,0" />

        <!--  Busy Indicator  -->
        <ActivityIndicator
            Grid.RowSpan="9"
            IsRunning="{Binding IsBusy}"
            HeightRequest="100"
            WidthRequest="100" />
    </Grid>

</ContentPage>

